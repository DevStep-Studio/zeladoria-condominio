APP_NAME="Zeladoria API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zeladoria
DB_USERNAME=zeladoria
DB_PASSWORD=
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Use smtp em produção para enviar os e-mails pelo servidor configurado.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=contato@example.com
MAIL_FROM_NAME="${APP_NAME}"
# Generate a random secret (at least 32 characters); use the same value in the Next.js server.
FRONTEND_SERVICE_TOKEN=

# Endereço público do frontend, usado nos links de recuperação de senha
FRONTEND_URL=https://condominio.devstep.com.br
