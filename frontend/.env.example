# Server-only: never prefix sensitive backend variables with NEXT_PUBLIC_.
BACKEND_API_URL=http://127.0.0.1:8000/api/v1
BACKEND_SERVICE_TOKEN=

# ==============================================================================
# INTEGRAÇÕES DE APIs GRATUITAS (ZELADORIA CONDOMÍNIO)
# ==============================================================================

# Geoapify Location Platform (Plano Gratuito: 3.000 créditos / dia)
