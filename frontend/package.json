{
  "name": "zeladoria-frontend",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=react-server --import ./tests/setup.ts --test tests/fase1-fundacao.test.ts tests/fase2-prestador.test.ts tests/fase3-solicitacoes.test.ts tests/fase4-execucao.test.ts tests/fase5-financeiro.test.ts tests/fase6-comunicacao.test.ts tests/roadmap-evolucao.test.ts tests/marketplace.test.ts tests/zeladoria-pay.test.ts tests/navigation-rbac.test.ts tests/api-boundary.test.ts",
    "test:commercial": "tsx --conditions=react-server --import ./tests/setup.ts --test tests/commercial-contact.test.ts",
    "test:avisos-erros": "tsx --conditions=react-server --import ./tests/setup.ts --test tests/avisos-erros.test.ts",
    "test:pay": "tsx --conditions=react-server --import ./tests/setup.ts --test tests/zeladoria-pay.test.ts",
    "test:integration": "tsx --conditions=react-server --import ./tests/setup.ts --test tests/functional.test.ts",
    "test:marketplace": "tsx --conditions=react-server --import ./tests/setup.ts --test tests/marketplace.test.ts",
    "test:marketplace-real": "tsx --conditions=react-server --import ./tests/setup.ts --test tests/marketplace-real.test.ts",
    "test:reservas": "tsx --conditions=react-server --import ./tests/setup.ts --test tests/reservas.test.ts",
    "test:mapa": "tsx --conditions=react-server --import ./tests/setup.ts --test tests/mapa.test.ts",
    "test:portaria": "tsx --conditions=react-server --import ./tests/setup.ts --test tests/portaria-sindico-e2e.test.ts",
    "test:encomendas": "tsx --conditions=react-server --import ./tests/setup.ts --test tests/encomendas-functional.test.ts",
    "test:visitantes": "tsx --conditions=react-server --import ./tests/setup.ts --test tests/visitantes-functional.test.ts",
    "test:responsive": "playwright test --config=playwright.config.ts",
    "autocommit": "node scripts/auto-commit.mjs",
    "autocommit:push": "node scripts/auto-commit.mjs --push",
    "autocommit:once": "node scripts/auto-commit.mjs --once",
    "autocommit:start": "./scripts/auto-commit-daemon.sh start",
    "autocommit:stop": "./scripts/auto-commit-daemon.sh stop",
    "autocommit:status": "./scripts/auto-commit-daemon.sh status",
    "autocommit:logs": "./scripts/auto-commit-daemon.sh logs",
    "test:backend": "composer --working-dir=backend test",
    "setup:api": "node scripts/setup-api.mjs",
    "dev:backend": "composer --working-dir=backend dev"
  },
  "dependencies": {
    "@fullcalendar/react": "^7.0.2",
    "@types/leaflet": "^1.9.22",
    "@types/qrcode": "^1.5.6",
    "dotenv": "17.3.1",
    "leaflet": "^1.9.4",
    "next": "16.2.6",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "temporal-polyfill": "^1.0.3",
    "tsx": "^4.23.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
